rules_version = '2';
// Carnet d'entraînement EPS : règles de sécurité Firestore.
// Compte développeur : robs_57680@hotmail.fr (même adresse que dans config.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uidIs(u) { return signedIn() && request.auth.uid == u; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasUser() { return signedIn() && exists(userPath()); }
    function me() { return get(userPath()).data; }
    function isDev() { return hasUser() && me().role == 'dev'; }
    function isProf() { return hasUser() && (me().role == 'prof' || me().role == 'dev'); }
    function isEleve() { return hasUser() && me().role == 'eleve'; }
    function isDevEmail() { return signedIn() && request.auth.token.email == 'robs_57680@hotmail.fr'; }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // Établissements (2026.11.21-2)
    function etabPath(id) { return /databases/$(database)/documents/etablissements/$(id); }
    function etabProf(id) { return signedIn() && id is string && id != '' && exists(etabPath(id)) && request.auth.uid in get(etabPath(id)).data.profs; }
    function etabAdmin(id) { return etabProf(id) && request.auth.uid in get(etabPath(id)).data.admins; }

    // ---------- Comptes ----------
    match /users/{uid} {
      allow read: if uidIs(uid) || isDev()
        || (signedIn() && resource.data.profId == request.auth.uid);
      allow create: if (uidIs(uid) && isDevEmail() && request.resource.data.role == 'dev')
        || (isDev() && request.resource.data.role in ['prof', 'eleve'])
        || (isProf() && request.resource.data.role == 'eleve' && request.resource.data.profId == request.auth.uid);
      allow update: if isDev() && uid != request.auth.uid;
      allow delete: if (isDev() && uid != request.auth.uid)
        || (isProf() && resource.data.role == 'eleve' && resource.data.profId == request.auth.uid);
    }

    // ---------- Classes (et identifiants des élèves, visibles du seul prof) ----------
    match /classes/{cid} {
      allow read: if signedIn() && (resource.data.profId == request.auth.uid || isDev()
        || (isEleve() && me().classeId == cid));
      allow create: if isProf() && request.resource.data.profId == request.auth.uid;
      // etabId : seulement un établissement dont le prof est membre (ou vide)
      allow update: if isProf() && resource.data.profId == request.auth.uid
        && request.resource.data.profId == request.auth.uid
        && (request.resource.data.get('etabId', '') == resource.data.get('etabId', '')
          || request.resource.data.get('etabId', '') == ''
          || etabProf(request.resource.data.get('etabId', '')));
      allow delete: if isProf() && resource.data.profId == request.auth.uid;

      match /eleves/{eid} {
        allow read, write: if isProf()
          && get(/databases/$(database)/documents/classes/$(cid)).data.profId == request.auth.uid;
      }
    }

    // ---------- Carnets d'entraînement ----------
    match /carnets/{carnetId} {
      allow read: if signedIn() && (resource.data.eleveUid == request.auth.uid
        || request.auth.uid in resource.data.get('membres', [])
        || resource.data.profId == request.auth.uid || isDev());
      allow create: if isEleve()
        && request.resource.data.eleveUid == request.auth.uid
        && request.resource.data.profId == me().profId
        && request.resource.data.classeId == me().classeId
        && carnetId == request.auth.uid + '_' + request.resource.data.activite
        && !('afl3Prof' in request.resource.data)
        // Carnet de groupe : créé par un élève qui en fait partie
        || isEleve()
        && carnetId.matches('g_[a-z0-9]+')
        && request.resource.data.groupe == true
        && request.auth.uid in request.resource.data.membres
        && request.resource.data.profId == me().profId
        && request.resource.data.classeId == me().classeId
        && !('afl3Prof' in request.resource.data) && !('afl3Profs' in request.resource.data);
      allow update: if signedIn() && (
        (resource.data.eleveUid == request.auth.uid && onlyKeys(['profil', 'updatedAt']))
        || (request.auth.uid in resource.data.get('membres', []) && onlyKeys(['profil', 'membres', 'logins', 'updatedAt']))
        || (resource.data.profId == request.auth.uid && onlyKeys(['afl3Prof', 'afl3Profs', 'updatedAt'])));
      allow delete: if signedIn() && resource.data.profId == request.auth.uid;

      match /seances/{sid} {
        function carnet() { return get(/databases/$(database)/documents/carnets/$(carnetId)).data; }
        // Propriétaire du carnet, ou membre du groupe pour un carnet partagé
        function owner() { return carnet().get('eleveUid', '') == request.auth.uid || request.auth.uid in carnet().get('membres', []); }
        allow read: if signedIn() && (resource.data.coachUid == request.auth.uid
          || owner() || carnet().profId == request.auth.uid || isDev());
        allow create: if signedIn() && owner();
        // Une séance validée est verrouillée pour l'élève ; seul le prof peut la déverrouiller.
        allow update: if signedIn() && (
          (owner() && resource.data.valide != true)
          || (carnet().profId == request.auth.uid && onlyKeys(['valide']))
          // Le coach choisi par l'élève ne peut écrire que les tours (passages, NO REP, adaptations).
          || (resource.data.coachUid == request.auth.uid && resource.data.valide != true
              && onlyKeys(['real', 'coachMaj'])
              && request.resource.data.real.diff(resource.data.real).affectedKeys().hasOnly(['tours']))
          // Carnets modifiables : le coach n'écrit que dans les réponses (cases « remplies par le coach »).
          || (resource.data.coachUid == request.auth.uid && resource.data.valide != true
              && onlyKeys(['valeurs', 'coachMaj'])));
        allow delete: if signedIn() && (
          (owner() && resource.data.valide != true)
          || carnet().profId == request.auth.uid);
      }
    }

    // ---------- Corrections du prof (id = carnetId__sid) ----------
    // Le prof corrige les pages de ses élèves ; l'élève (ou chaque membre du groupe) ne lit la correction
    // qu'une fois envoyée ET rendue visible par le prof (visible == true).
    match /corrections/{id} {
      allow read: if signedIn() && (resource.data.profId == request.auth.uid
        || (request.auth.uid in resource.data.get('eleves', []) && resource.data.visible == true));
      allow create: if isProf() && request.resource.data.profId == request.auth.uid
        && id == request.resource.data.carnetId + '__' + request.resource.data.sid
        && get(/databases/$(database)/documents/carnets/$(request.resource.data.carnetId)).data.profId == request.auth.uid;
      allow update: if isProf() && resource.data.profId == request.auth.uid
        && request.resource.data.profId == request.auth.uid
        && request.resource.data.carnetId == resource.data.carnetId
        && request.resource.data.sid == resource.data.sid;
      allow delete: if signedIn() && resource.data.profId == request.auth.uid;
    }

    // ---------- Identifiants élèves (pour choisir un coach de sa classe) ----------
    match /logins/{login} {
      allow read: if signedIn() && (resource.data.profId == request.auth.uid
        || (isEleve() && resource.data.classeId == me().classeId));
      allow create: if isProf() && request.resource.data.profId == request.auth.uid;
      allow delete: if isProf() && resource.data.profId == request.auth.uid;
      // Pseudo affiché sur les feuilles de match : choisi par l'élève (ou corrigé par son prof)
      allow update: if onlyKeys(['pseudo', 'avatar'])
        && request.resource.data.get('pseudo', '') is string && request.resource.data.get('pseudo', '').size() <= 20
        && request.resource.data.get('avatar', '') is string && request.resource.data.get('avatar', '').size() <= 8
        && ((isEleve() && resource.data.uid == request.auth.uid) || (isProf() && resource.data.profId == request.auth.uid));
    }

    // ---------- Séances d'outils (feuille de match, scoreur) ----------
    match /sessions/{id} {
      allow read: if signedIn() && (resource.data.profId == request.auth.uid
        || (isEleve() && resource.data.classeId == me().classeId));
      allow create: if isProf() && request.resource.data.profId == request.auth.uid;
      allow update: if isProf() && resource.data.profId == request.auth.uid
        && request.resource.data.profId == request.auth.uid;
      allow delete: if isProf() && resource.data.profId == request.auth.uid;
      // Scores : tous les élèves de la classe pendant la séance ouverte, et le prof
      match /matchs/{mid} {
        function sess() { return get(/databases/$(database)/documents/sessions/$(id)).data; }
        allow read: if signedIn() && (sess().profId == request.auth.uid
          || (isEleve() && sess().classeId == me().classeId));
        allow write: if signedIn() && (sess().profId == request.auth.uid
          || (isEleve() && sess().classeId == me().classeId && sess().active == true));
      }
      // Course d'orientation : correction d'un carton, lisible par l'élève seulement après avoir validé ce carton
      match /corr/{cid} {
        function sess() { return get(/databases/$(database)/documents/sessions/$(id)).data; }
        allow read: if signedIn() && (sess().profId == request.auth.uid
          || (isEleve() && get(/databases/$(database)/documents/sessions/$(id)/courses/$(request.auth.uid + '_' + cid)).data.fini == true));
        allow write: if signedIn() && sess().profId == request.auth.uid;
      }
      // Course d'orientation : réponses et chrono de l'élève (verrouillés une fois le carton validé)
      match /courses/{rid} {
        function sess() { return get(/databases/$(database)/documents/sessions/$(id)).data; }
        allow read: if signedIn() && (resource.data.eleveUid == request.auth.uid || sess().profId == request.auth.uid);
        allow create: if isEleve() && request.resource.data.eleveUid == request.auth.uid
          && rid == request.auth.uid + '_' + request.resource.data.cartonId
          && sess().classeId == me().classeId && sess().active == true;
        allow update: if isEleve() && resource.data.eleveUid == request.auth.uid && resource.data.fini != true
          && request.resource.data.eleveUid == request.auth.uid
          && request.resource.data.cartonId == resource.data.cartonId
          && request.resource.data.debut == resource.data.debut;
        // Le prof peut supprimer une course pour que l'élève recommence
        allow delete: if signedIn() && sess().profId == request.auth.uid;
      }
    }

    // ---------- Accueil élève ----------
    // Réglages du prof (barème du score d'activité, couleurs, défi de la semaine), lus par ses élèves
    match /profcfg/{pid} {
      allow read: if signedIn();
      allow write: if uidIs(pid) && isProf();
    }
    // Activité physique de la semaine (saisie par l'élève, bientôt importée depuis Santé), lue par son prof
    match /activite/{uid} {
      allow read: if signedIn() && (uidIs(uid) || resource.data.profId == request.auth.uid);
      allow create, update: if uidIs(uid) && isEleve() && request.resource.data.profId == me().profId;
    }
    // Actualités : compétitions, AS, informations
    // portee 'etab' : visible de tous les élèves de l'établissement, publiée par un prof membre.
    match /actus/{id} {
      allow read: if signedIn();
      allow create: if isProf() && request.resource.data.profId == request.auth.uid
        && (request.resource.data.get('portee', 'classes') != 'etab' || etabProf(request.resource.data.get('etabId', '')));
      allow update: if isProf() && resource.data.profId == request.auth.uid
        && request.resource.data.profId == request.auth.uid
        && (request.resource.data.get('portee', 'classes') != 'etab' || etabProf(request.resource.data.get('etabId', '')));
      allow delete: if isProf() && resource.data.profId == request.auth.uid;
    }

    // ---------- Séances à coacher ----------
    match /coachings/{id} {
      allow read: if signedIn() && (resource.data.coachUid == request.auth.uid || resource.data.eleveUid == request.auth.uid);
      allow create, update: if isEleve() && request.resource.data.eleveUid == request.auth.uid
        && get(/databases/$(database)/documents/carnets/$(request.resource.data.carnetId)).data.eleveUid == request.auth.uid
        && id == request.resource.data.carnetId + '__' + request.resource.data.sid;
      allow delete: if signedIn() && resource.data.eleveUid == request.auth.uid;
    }

    // ---------- Dossiers d'activité (carnets + fiches), lus par les élèves ----------
    match /dossiers/{id} {
      allow read: if signedIn();
      allow create: if isProf() && request.resource.data.profId == request.auth.uid;
      allow update: if isProf() && resource.data.profId == request.auth.uid
        && request.resource.data.profId == request.auth.uid;
      allow delete: if isProf() && resource.data.profId == request.auth.uid;
    }

    // ---------- Stock : activités partagées entre profs ----------
    match /stock/{id} {
      allow read: if isProf();
      allow create: if isProf() && request.resource.data.auteurId == request.auth.uid
        && request.resource.data.principe is string && request.resource.data.principe.size() >= 30;
      allow update: if isProf() && resource.data.auteurId == request.auth.uid
        && request.resource.data.auteurId == request.auth.uid && request.resource.data.principe.size() >= 30;
      allow delete: if isProf() && resource.data.auteurId == request.auth.uid;
    }

    // ---------- Fiches ressources (déposées par le prof, lues par ses élèves) ----------
    match /fiches/{id} {
      allow read: if signedIn();
      allow create: if isProf() && request.resource.data.profId == request.auth.uid;
      allow update: if isProf() && resource.data.profId == request.auth.uid
        && request.resource.data.profId == request.auth.uid;
      allow delete: if isProf() && resource.data.profId == request.auth.uid;
      match /parts/{n} {
        allow read: if signedIn();
        allow write: if isProf() && get(/databases/$(database)/documents/fiches/$(id)).data.profId == request.auth.uid;
      }
    }

    // ---------- Modèles de carnets ----------
    match /modeles/{id} {
      allow read: if signedIn();
      allow create: if isProf() && request.resource.data.profId == request.auth.uid;
      allow update: if isProf() && resource.data.profId == request.auth.uid
        && request.resource.data.profId == request.auth.uid;
      allow delete: if isProf() && resource.data.profId == request.auth.uid;
    }

    // ---------- Course d'orientation : cartons et correction du prof (jamais lus par les élèves) ----------
    match /orient/{id} {
      allow read, delete: if signedIn() && resource.data.profId == request.auth.uid;
      allow create: if isProf() && request.resource.data.profId == request.auth.uid;
      allow update: if isProf() && resource.data.profId == request.auth.uid
        && request.resource.data.profId == request.auth.uid;
    }

    // ---------- Sorties de l'appli pendant les créneaux d'EPS ----------
    // L'élève enregistre ses sorties ; son prof les lit et peut lui envoyer un avertissement (champ avert).
    match /vigie/{uid} {
      allow read: if signedIn() && (uidIs(uid) || resource.data.profId == request.auth.uid);
      allow create: if (uidIs(uid) && isEleve() && request.resource.data.profId == me().profId
          && request.resource.data.classeId == me().classeId && !('avert' in request.resource.data))
        || (isProf() && request.resource.data.profId == request.auth.uid
          && request.resource.data.keys().hasOnly(['profId', 'classeId', 'login', 'avert']));
      allow update: if (uidIs(uid) && isEleve() && request.resource.data.profId == me().profId
          && request.resource.data.get('avert', null) == resource.data.get('avert', null))
        || (isProf() && resource.data.profId == request.auth.uid && onlyKeys(['avert']));
    }

    // ---------- QCM (2026.11.20-10 / -11) ----------
    // Questions : lues par tous les comptes connectés (aucune bonne réponse dedans).
    match /qcms/{id} {
      allow read: if signedIn();
      allow create: if isProf() && request.resource.data.profId == request.auth.uid;
      allow update: if isProf() && resource.data.profId == request.auth.uid && request.resource.data.profId == request.auth.uid;
      allow delete: if isProf() && resource.data.profId == request.auth.uid;
    }
    // Corrigé : le prof ; l'élève seulement après avoir validé une première fois.
    match /qcmcles/{id} {
      allow read: if signedIn() && (resource.data.profId == request.auth.uid
        || (isEleve() && exists(/databases/$(database)/documents/qcmrep/$(id + '__' + request.auth.uid))));
      allow create: if isProf() && request.resource.data.profId == request.auth.uid;
      allow update: if isProf() && resource.data.profId == request.auth.uid && request.resource.data.profId == request.auth.uid;
      allow delete: if isProf() && resource.data.profId == request.auth.uid;
    }
    // Réponses : id = qcmId__uid. Créées puis mises à jour (nouvel essai) par l'élève, seulement si le QCM est ouvert
    // dans la séance d'aujourd'hui de sa classe et qu'il lui reste des essais.
    function qcmOuvert(qid) {
      return qid in get(/databases/$(database)/documents/classes/$(me().classeId)).data.get('seanceJour', {}).get('qcms', []);
    }
    function qcmEssaisMax(qid) { return get(/databases/$(database)/documents/qcms/$(qid)).data.get('essais', 1); }
    match /qcmrep/{rid} {
      allow read: if signedIn() && (rid.matches('.*__' + request.auth.uid)
        || resource.data.profId == request.auth.uid);
      allow create: if isEleve()
        && rid == request.resource.data.qcmId + '__' + request.auth.uid
        && request.resource.data.eleveUid == request.auth.uid
        && request.resource.data.profId == me().profId
        && request.resource.data.classeId == me().classeId
        && request.resource.data.essais == 1
        && qcmOuvert(request.resource.data.qcmId);
      allow update: if isEleve()
        && resource.data.eleveUid == request.auth.uid
        && request.resource.data.eleveUid == request.auth.uid
        && request.resource.data.qcmId == resource.data.qcmId
        && request.resource.data.profId == resource.data.profId
        && request.resource.data.classeId == resource.data.classeId
        && request.resource.data.essais == resource.data.get('essais', 1) + 1
        && (qcmEssaisMax(resource.data.qcmId) == 0 || request.resource.data.essais <= qcmEssaisMax(resource.data.qcmId))
        && qcmOuvert(resource.data.qcmId);
      allow delete: if isProf() && resource.data.profId == request.auth.uid;
    }
    // Notes retenues par le prof (tableau des carnets).
    match /aflnotes/{id} {
      allow read, delete: if signedIn() && resource.data.profId == request.auth.uid;
      allow create: if isProf() && request.resource.data.profId == request.auth.uid;
      allow update: if isProf() && resource.data.profId == request.auth.uid && request.resource.data.profId == request.auth.uid;
    }

    // ---------- Établissements (2026.11.21-2) ----------
    // Créé par un prof qui en devient administrateur ; les admins acceptent les demandes, nomment d'autres admins,
    // choisissent la phrase secrète (sel + vérificateur chiffré, jamais la phrase). Un membre peut seulement partir.
    match /etablissements/{id} {
      allow read: if isProf();
      allow create: if isProf() && request.resource.data.createur == request.auth.uid
        && request.resource.data.admins == [request.auth.uid] && request.resource.data.profs == [request.auth.uid]
        && request.resource.data.nom is string && request.resource.data.nom.size() > 1 && request.resource.data.nom.size() <= 80
        && request.resource.data.emails.keys().hasOnly([request.auth.uid]);
      allow update: if isProf() && (
        (request.auth.uid in resource.data.admins
          && request.resource.data.createur == resource.data.createur
          && request.resource.data.admins.size() > 0
          && request.resource.data.profs.hasAll(request.resource.data.admins))
        || (request.auth.uid in resource.data.profs
          && onlyKeys(['profs', 'admins', 'emails'])
          && request.resource.data.profs == resource.data.profs.removeAll([request.auth.uid])
          && request.resource.data.admins == resource.data.admins.removeAll([request.auth.uid])
          && request.resource.data.admins.size() > 0
          && request.resource.data.emails.diff(resource.data.emails).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if isProf() && request.auth.uid in resource.data.admins && resource.data.profs.size() <= 1;
    }
    // Demandes pour rejoindre un établissement (id = etabId__uid), validées par un administrateur
    match /etabdemandes/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || etabAdmin(resource.data.etabId));
      allow create: if isProf() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.etabId + '__' + request.auth.uid
        && exists(etabPath(request.resource.data.etabId));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || etabAdmin(resource.data.etabId));
    }
    // Défis communs à l'établissement : seul l'auteur les modifie ou les supprime
    match /etabdefis/{id} {
      allow read: if signedIn();
      allow create: if isProf() && request.resource.data.profId == request.auth.uid && etabProf(request.resource.data.etabId);
      allow update: if isProf() && resource.data.profId == request.auth.uid
        && request.resource.data.profId == request.auth.uid && request.resource.data.etabId == resource.data.etabId;
      allow delete: if signedIn() && resource.data.profId == request.auth.uid;
    }
    // Inscriptions aux compétitions (id = actuId__uid) : identifiant et classe seulement, jamais de nom.
    // Lues par l'élève, son prof et l'organisateur (auteur de l'actualité).
    function actuDe(a) { return get(/databases/$(database)/documents/actus/$(a)).data; }
    match /inscriptions/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid
        || resource.data.profId == request.auth.uid || resource.data.organisateur == request.auth.uid);
      allow create: if isEleve()
        && id == request.resource.data.actuId + '__' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.profId == me().profId
        && request.resource.data.classeId == me().classeId
        && request.resource.data.login == me().login
        && actuDe(request.resource.data.actuId).get('inscription', false) == true
        && request.resource.data.organisateur == actuDe(request.resource.data.actuId).profId
        && (actuDe(request.resource.data.actuId).profId == me().profId
          || (actuDe(request.resource.data.actuId).get('portee', '') == 'etab'
            && actuDe(request.resource.data.actuId).get('etabId', '') == get(/databases/$(database)/documents/classes/$(me().classeId)).data.get('etabId', '-')));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid
        || resource.data.profId == request.auth.uid || resource.data.organisateur == request.auth.uid);
    }
    // Noms des élèves chiffrés sur l'appareil du prof (AES-GCM, clé tirée de la phrase secrète) : id = classeId.
    // Lisibles par les profs de l'établissement ; écrits par le prof de la classe (ou un admin qui re-chiffre).
    match /nomsChiffres/{cid} {
      allow read: if signedIn() && (resource == null || etabProf(resource.data.etabId));
      allow create, update: if isProf() && etabProf(request.resource.data.etabId)
        && ((request.resource.data.profId == request.auth.uid
            && get(/databases/$(database)/documents/classes/$(cid)).data.profId == request.auth.uid)
          || (resource != null && etabAdmin(request.resource.data.etabId)
            && resource.data.etabId == request.resource.data.etabId
            && request.resource.data.profId == resource.data.profId));
      allow delete: if signedIn() && resource.data.profId == request.auth.uid;
    }

    // ---------- Préférences privées du prof (clé Gemini personnelle) ----------
    match /prefs/{uid} {
      allow read, write: if uidIs(uid) && isProf();
    }

    // ---------- Demandes d'accès prof ----------
    match /demandes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'etablissement', 'message', 'statut', 'createdAt'])
        && request.resource.data.email is string && request.resource.data.email.size() > 5 && request.resource.data.email.size() < 120
        && request.resource.data.etablissement is string && request.resource.data.etablissement.size() < 200
        && request.resource.data.message is string && request.resource.data.message.size() < 1000
        && request.resource.data.statut == 'nouvelle';
      allow read, update, delete: if isDev();
    }
  }
}
